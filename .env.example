# Event site domain (the host serving /safezone, api.<host> and event-public.<host>)
SITE_HOST=example.com
# The engine exits for good after this UTC time (ISO 8601)
END_AT=2026-10-24T20:20:00Z
# Optional: Telegram alerts (lost session, API block, strategy switched off, daily PnL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Kick chat announcements of each trade. Set by `node import-cookies.mjs`, do not paste by hand.
KICK_BEARER=

# Optional: port of the local live dashboard (http://127.0.0.1:7788 by default)
# DASH_PORT=7788
